# ---------- Database ----------
DATABASE_URL=postgresql+psycopg2://civicai:civicai@localhost:5432/civicai
# SQLite fallback for zero-setup demo (used automatically if USE_SQLITE=true)
USE_SQLITE=true
SQLITE_PATH=./civicai.db

# ---------- Auth ----------
JWT_SECRET=change_this_super_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- AI ----------
AI_MODE=demo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---------- Storage ----------
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=../uploads
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=civicai-uploads

# ---------- Deadlines (hours) ----------
ACKNOWLEDGEMENT_DEADLINE_HOURS=6
CRITICAL_RESOLUTION_HOURS=12
HIGH_RESOLUTION_HOURS=24
MEDIUM_RESOLUTION_HOURS=48
LOW_RESOLUTION_HOURS=72

# ---------- Duplicate Detection ----------
TEXT_SIMILARITY_THRESHOLD=0.70
DUPLICATE_RADIUS_METERS=100

# ---------- Scheduler ----------
SCHEDULER_INTERVAL_MINUTES=1

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
